				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Ejecutar script de shell</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>#!/bin/bash

# Automator utiliza un PATH reducido.
# Añadimos las ubicaciones habituales de Homebrew.
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

FFMPEG="$(command -v ffmpeg)"

# Comprobar que FFmpeg está instalado
if [[ -z "$FFMPEG" ]]; then
    osascript -e '
        display alert "FFmpeg no está instalado" ¬
        message "Instálalo desde Terminal con:\n\nbrew install ffmpeg" ¬
        as critical
    '
    exit 1
fi

converted=0
failed=0
files=()

# Convierte un archivo a WAV mono, 16 kHz, PCM de 16 bits
convert_to_wav() {
    input="$1"

    [[ -f "$input" ]] || return

    directory="$(dirname "$input")"
    filename="$(basename "$input")"

    # Nombre sin extensión
    if [[ "$filename" == *.* &amp;&amp; "$filename" != .* ]]; then
        basename_without_extension="${filename%.*}"
    else
        basename_without_extension="$filename"
    fi

    output="$directory/$basename_without_extension.wav"

    # Evita sobrescribir el archivo original o un WAV ya existente
    if [[ "$output" == "$input" || -e "$output" ]]; then
        output="$directory/${basename_without_extension}_16k_mono.wav"

        counter=2
        while [[ -e "$output" ]]; do
            output="$directory/${basename_without_extension}_16k_mono_${counter}.wav"
            counter=$((counter + 1))
        done
    fi

    if "$FFMPEG" \
        -hide_banner \
        -loglevel error \
        -i "$input" \
        -vn \
        -ac 1 \
        -ar 16000 \
        -c:a pcm_s16le \
        "$output"
    then
        converted=$((converted + 1))
    else
        failed=$((failed + 1))
    fi
}

# Primero recopilamos todos los archivos.
# Esto evita que los WAV recién creados se vuelvan a procesar.
for item in "$@"; do
    if [[ -d "$item" ]]; then
        # Si se selecciona una carpeta, procesa su contenido recursivamente
        while IFS= read -r -d '' file; do
            files[${#files[@]}]="$file"
        done &lt; &lt;(find "$item" -type f -print0)
    elif [[ -f "$item" ]]; then
        files[${#files[@]}]="$item"
    fi
done

# Convertir todos los archivos recibidos
for file in "${files[@]}"; do
    convert_to_wav "$file"
done

# Mostrar resultado
if [[ "$failed" -gt 0 ]]; then
    osascript -e "display alert \"Conversión finalizada\" message \"Archivos convertidos: $converted\nArchivos con error: $failed\""
else
    osascript -e "display notification \"$converted archivo(s) convertido(s)\" with title \"Conversión a WAV completada\""
fi</string>
