				<key>ActionName</key>
				<string>Ejecutar script de shell</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>#!/bin/bash

# Automator / Acción rápida para transcribir vídeo o audio con whisper.cpp.
#
# El modelo se guarda en:
#   ~/.local/whisper.cpp/models/ggml-large-v3-turbo-q5_0.bin
#
# Si el modelo no existe o parece incompleto, se descarga automáticamente.
#
# Genera junto al archivo original:
#   nombre_transcripcion.txt
#   nombre_transcripcion.srt

export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

MODEL_DIR="$HOME/.local/whisper.cpp/models"
MODEL_NAME="ggml-large-v3-turbo-q5_0.bin"
MODEL="$MODEL_DIR/$MODEL_NAME"
MODEL_URL="https://huggingface.co/ggerganov/whisper.cpp/resolve/main/$MODEL_NAME"

# Tamaño mínimo aproximado para detectar una descarga incompleta.
MIN_MODEL_BYTES=500000000

# Usa "auto" para detectar automáticamente el idioma.
# También puedes poner: es, en, fr, de, etc.
LANGUAGE="${LANGUAGE:-auto}"

success=0
failed=0
files=()

show_alert() {
    local title="$1"
    local message="$2"
    local style="${3:-critical}"

    /usr/bin/osascript - "$title" "$message" "$style" &lt;&lt;'APPLESCRIPT'
on run argv
    set alertTitle to item 1 of argv
    set alertMessage to item 2 of argv
    set alertStyle to item 3 of argv

    if alertStyle is "warning" then
        display alert alertTitle message alertMessage as warning
    else
        display alert alertTitle message alertMessage as critical
    end if
end run
APPLESCRIPT
}

show_notification() {
    local title="$1"
    local message="$2"

    /usr/bin/osascript - "$title" "$message" &lt;&lt;'APPLESCRIPT'
on run argv
    display notification (item 2 of argv) with title (item 1 of argv)
end run
APPLESCRIPT
}

file_size_bytes() {
    local file="$1"

    if [[ ! -f "$file" ]]; then
        printf '0\n'
        return
    fi

    /usr/bin/wc -c &lt; "$file" | /usr/bin/tr -d '[:space:]'
}

find_whisper_cli() {
    local found
    local candidate

    found="$(command -v whisper-cli 2&gt;/dev/null)"

    if [[ -n "$found" &amp;&amp; -x "$found" ]]; then
        printf '%s\n' "$found"
        return 0
    fi

    for candidate in \
        "$HOME/.local/whisper.cpp/build/bin/whisper-cli" \
        "$HOME/whisper.cpp/build/bin/whisper-cli" \
        "/usr/local/bin/whisper-cli" \
        "/opt/homebrew/bin/whisper-cli"
    do
        if [[ -x "$candidate" ]]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done

    return 1
}

ensure_model() {
    local current_size
    local temporary_model
    local downloaded_size
    local curl_bin

    current_size="$(file_size_bytes "$MODEL")"

    if [[ "$current_size" -ge "$MIN_MODEL_BYTES" ]]; then
        echo "Modelo encontrado:"
        echo "$MODEL"
        return 0
    fi

    curl_bin="$(command -v curl 2&gt;/dev/null)"

    if [[ -z "$curl_bin" || ! -x "$curl_bin" ]]; then
        show_alert \
            "No se encuentra curl" \
            "No se puede descargar el modelo Whisper porque curl no está disponible."

        return 1
    fi

    if ! /bin/mkdir -p "$MODEL_DIR"; then
        show_alert \
            "No se puede crear la carpeta del modelo" \
            "Ruta:\n\n$MODEL_DIR"

        return 1
    fi

    if [[ -f "$MODEL" ]]; then
        /bin/rm -f "$MODEL"
    fi

    temporary_model="${MODEL}.part"

    /bin/rm -f "$temporary_model"

    show_notification \
        "Whisper" \
        "Descargando el modelo Large v3 Turbo Q5. Puede tardar varios minutos."

    echo "Descargando modelo:"
    echo "$MODEL_URL"
    echo
    echo "Destino:"
    echo "$MODEL"
    echo

    if ! "$curl_bin" \
        --fail \
        --location \
        --retry 3 \
        --retry-delay 2 \
        --connect-timeout 30 \
        --progress-bar \
        --output "$temporary_model" \
        "$MODEL_URL"
    then
        /bin/rm -f "$temporary_model"

        show_alert \
            "Error al descargar el modelo" \
            "No se pudo descargar:\n\n$MODEL_URL\n\nComprueba la conexión a Internet y vuelve a intentarlo."

        return 1
    fi

    downloaded_size="$(file_size_bytes "$temporary_model")"

    if [[ "$downloaded_size" -lt "$MIN_MODEL_BYTES" ]]; then
        /bin/rm -f "$temporary_model"

        show_alert \
            "Descarga del modelo incompleta" \
            "El archivo descargado es demasiado pequeño:\n\n${downloaded_size} bytes\n\nVuelve a ejecutar la acción para reintentarlo."

        return 1
    fi

    if ! /bin/mv "$temporary_model" "$MODEL"; then
        /bin/rm -f "$temporary_model"

        show_alert \
            "No se puede guardar el modelo" \
            "Ruta de destino:\n\n$MODEL"

        return 1
    fi

    show_notification \
        "Whisper" \
        "Modelo descargado correctamente."

    echo "Modelo descargado correctamente:"
    echo "$MODEL"

    return 0
}

transcribe_file() {
    local input="$1"
    local directory
    local filename
    local name
    local output_base
    local counter
    local temp_directory
    local temporary_audio
    local temporary_log
    local status

    [[ -f "$input" ]] || return

    directory="$(dirname "$input")"
    filename="$(basename "$input")"

    if [[ "$filename" == *.* &amp;&amp; "$filename" != .* ]]; then
        name="${filename%.*}"
    else
        name="$filename"
    fi

    output_base="$directory/${name}_transcripcion"

    # Evitar sobrescribir transcripciones existentes.
    if [[ -e "${output_base}.txt" || -e "${output_base}.srt" ]]; then
        counter=2

        while :; do
            output_base="$directory/${name}_transcripcion_${counter}"

            if [[ ! -e "${output_base}.txt" &amp;&amp; ! -e "${output_base}.srt" ]]; then
                break
            fi

            counter=$((counter + 1))
        done
    fi

    temp_directory="$(/usr/bin/mktemp -d "/tmp/whisper-automator.XXXXXX")"

    if [[ -z "$temp_directory" || ! -d "$temp_directory" ]]; then
        failed=$((failed + 1))
        return
    fi

    temporary_audio="$temp_directory/audio.wav"
    temporary_log="$temp_directory/whisper.log"

    echo
    echo "Procesando:"
    echo "$input"
    echo
    echo "Salida:"
    echo "${output_base}.txt"
    echo "${output_base}.srt"
    echo

    # Convertir vídeo o audio a WAV mono, 16 kHz y PCM de 16 bits.
    if ! "$FFMPEG" \
        -hide_banner \
        -loglevel error \
        -y \
        -i "$input" \
        -vn \
        -ac 1 \
        -ar 16000 \
        -c:a pcm_s16le \
        "$temporary_audio" \
        2&gt; "$temporary_log"
    then
        failed=$((failed + 1))

        /bin/mv \
            "$temporary_log" \
            "$directory/${name}_ffmpeg_error.log"

        /bin/rm -rf "$temp_directory"

        return
    fi

    # Transcribir y generar TXT + SRT.
    "$WHISPER_CLI" \
        -m "$MODEL" \
        -f "$temporary_audio" \
        -l "$LANGUAGE" \
        -osrt \
        -otxt \
        -of "$output_base" \
        &gt; "$temporary_log" 2&gt;&amp;1

    status=$?

    if [[ "$status" -eq 0 &amp;&amp; -s "${output_base}.txt" ]]; then
        success=$((success + 1))

        echo "Transcripción completada:"
        echo "${output_base}.txt"
    else
        failed=$((failed + 1))

        /bin/mv \
            "$temporary_log" \
            "$directory/${name}_whisper_error.log"

        [[ -s "${output_base}.txt" ]] || /bin/rm -f "${output_base}.txt"
        [[ -s "${output_base}.srt" ]] || /bin/rm -f "${output_base}.srt"

        echo "Error al transcribir:"
        echo "$input"
        echo
        echo "Log:"
        echo "$directory/${name}_whisper_error.log"
    fi

    /bin/rm -rf "$temp_directory"
}

# Localizar FFmpeg.
FFMPEG="$(command -v ffmpeg 2&gt;/dev/null)"

if [[ -z "$FFMPEG" || ! -x "$FFMPEG" ]]; then
    show_alert \
        "FFmpeg no está instalado" \
        "Instálalo desde Terminal con:\n\nbrew install ffmpeg"

    exit 1
fi

# Localizar whisper-cli.
WHISPER_CLI="$(find_whisper_cli)"

if [[ -z "$WHISPER_CLI" || ! -x "$WHISPER_CLI" ]]; then
    show_alert \
        "No se encuentra whisper-cli" \
        "Comprueba la instalación de whisper.cpp y la ruta de whisper-cli."

    exit 1
fi

echo "FFmpeg:"
echo "$FFMPEG"
echo

echo "Whisper CLI:"
echo "$WHISPER_CLI"
echo

# Comprobar o descargar el modelo automáticamente.
if ! ensure_model; then
    exit 1
fi

# Recoger archivos seleccionados.
for item in "$@"; do
    if [[ -d "$item" ]]; then
        while IFS= read -r -d '' file; do
            files[${#files[@]}]="$file"
        done &lt; &lt;(
            find "$item" -type f \( \
                -iname "*.mp4" \
                -o -iname "*.mov" \
                -o -iname "*.mkv" \
                -o -iname "*.avi" \
                -o -iname "*.webm" \
                -o -iname "*.m4v" \
                -o -iname "*.wav" \
                -o -iname "*.mp3" \
                -o -iname "*.m4a" \
                -o -iname "*.aac" \
                -o -iname "*.flac" \
                -o -iname "*.ogg" \
                -o -iname "*.opus" \
                -o -iname "*.wma" \
            \) -print0
        )
    elif [[ -f "$item" ]]; then
        files[${#files[@]}]="$item"
    fi
done

if [[ "${#files[@]}" -eq 0 ]]; then
    show_alert \
        "No hay archivos compatibles" \
        "Selecciona uno o varios archivos de vídeo o audio." \
        "warning"

    exit 1
fi

show_notification \
    "Whisper" \
    "Procesando ${#files[@]} archivo(s). Puede tardar."

# Procesar secuencialmente para evitar saturar la memoria.
for file in "${files[@]}"; do
    transcribe_file "$file"
done

if [[ "$failed" -gt 0 ]]; then
    show_alert \
        "Transcripción finalizada" \
        "Completadas: $success\nCon errores: $failed\n\nLos errores se guardaron en archivos .log junto a los originales." \
        "warning"
else
    show_notification \
        "Whisper completado" \
        "$success archivo(s) transcrito(s)."
fi

exit 0</string>
					<key>CheckedForUserDefaultShell</key>
					<true/>
					<key>inputMethod</key>
					<integer>1</integer>
					<key>shell</key>
					<string>/bin/bash</string>
					<key>source</key>
					<string></string>
				</dict>
