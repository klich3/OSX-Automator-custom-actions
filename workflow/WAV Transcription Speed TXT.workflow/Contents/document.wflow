				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Ejecutar script de shell</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>#!/bin/bash

export PATH="$HOME/.local/llama-vulkan/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

LLAMA_CLI="$HOME/.local/llama-vulkan/bin/llama-mtmd-cli"
MODEL="ggml-org/Qwen3-ASR-0.6B-GGUF"
PROMPT="Transcribe exactamente el audio, manteniendo el idioma original."

if [[ ! -x "$LLAMA_CLI" ]]; then
    osascript -e '
        display alert "No se encuentra llama-mtmd-cli" ¬
        message "Ruta esperada:\n\n~/.local/llama-vulkan/bin/llama-mtmd-cli" ¬
        as critical
    '
    exit 1
fi

success=0
failed=0
files=()

transcribe_audio() {
    input="$1"

    [[ -f "$input" ]] || return

    directory="$(dirname "$input")"
    filename="$(basename "$input")"

    if [[ "$filename" == *.* &amp;&amp; "$filename" != .* ]]; then
        name="${filename%.*}"
    else
        name="$filename"
    fi

    output="$directory/${name}_transcripcion_rapida.txt"

    # Evitar sobrescribir archivos existentes
    if [[ -e "$output" ]]; then
        counter=2
        output="$directory/${name}_transcripcion_rapida_${counter}.txt"

        while [[ -e "$output" ]]; do
            counter=$((counter + 1))
            output="$directory/${name}_transcripcion_rapida_${counter}.txt"
        done
    fi

    log_file="$(mktemp "/tmp/qwen-asr-fast.XXXXXX")"

    "$LLAMA_CLI" \
        -hf "$MODEL" \
        --audio "$input" \
        -ngl all \
        -c 16384 \
        --flash-attn off \
        --temp 0 \
        -n 8192 \
        -p "$PROMPT" \
        &gt; "$output" 2&gt; "$log_file"

    status=$?

    if [[ "$status" -eq 0 &amp;&amp; -s "$output" ]]; then
        success=$((success + 1))
        rm -f "$log_file"
    else
        failed=$((failed + 1))

        error_file="$directory/${name}_transcripcion_rapida_error.log"
        mv "$log_file" "$error_file"

        [[ -s "$output" ]] || rm -f "$output"
    fi
}

# Recoger archivos seleccionados o contenidos dentro de carpetas
for item in "$@"; do
    if [[ -d "$item" ]]; then
        while IFS= read -r -d '' file; do
            files[${#files[@]}]="$file"
        done &lt; &lt;(
            find "$item" -type f \( \
                -iname "*.wav" \
                -o -iname "*.mp3" \
                -o -iname "*.m4a" \
                -o -iname "*.aac" \
                -o -iname "*.flac" \
                -o -iname "*.ogg" \
                -o -iname "*.opus" \
            \) -print0
        )
    elif [[ -f "$item" ]]; then
        files[${#files[@]}]="$item"
    fi
done

if [[ "${#files[@]}" -eq 0 ]]; then
    osascript -e '
        display alert "No hay archivos de audio" ¬
        message "Selecciona uno o varios archivos de audio." ¬
        as warning
    '
    exit 1
fi

# Procesar secuencialmente
for file in "${files[@]}"; do
    transcribe_audio "$file"
done

if [[ "$failed" -gt 0 ]]; then
    osascript -e "
        display alert \"Transcripción finalizada\" \
        message \"Completadas: $success\nCon errores: $failed\n\nLos errores se guardaron junto al audio.\"
    "
else
    osascript -e "
        display notification \"$success archivo(s) transcrito(s)\" \
        with title \"Transcripción rápida completada\"
    "
fi</string>
